# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
#   cp .env.example .env        (bash)
#   Copy-Item .env.example .env (PowerShell)

# UID used inside the Airflow containers (irrelevant on native Windows, matters if you're
# running Docker via WSL2 with a Linux user mapping). 50000 is the image's built-in "airflow" user.
AIRFLOW_UID=50000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Used to encrypt Connection passwords stored in Airflow's metadata DB. Leave blank for local dev
# (Airflow will run unencrypted); set a real value before this ever holds real credentials.
AIRFLOW_FERNET_KEY=

# Signs Airflow's webserver session cookies. Change before running anywhere but local dev.
AIRFLOW_WEBSERVER_SECRET_KEY=please-change-me

# Airflow UI admin login, created automatically by the airflow-init container on first run.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Second, separate Postgres instance for business/application data (not Airflow's own metadata).
# Exposed on the host at BUSINESS_POSTGRES_PORT so external tools (pgAdmin, DBeaver) can connect directly.
BUSINESS_POSTGRES_USER=business
BUSINESS_POSTGRES_PASSWORD=business
BUSINESS_POSTGRES_DB=business
BUSINESS_POSTGRES_PORT=5433

# pgAdmin — UI for both Postgres instances (both are pre-registered under Servers, see pgadmin/servers.json).
# Login below is for pgAdmin itself; DB passwords are entered on first connect per server
# (airflow/airflow and business/business by default) since pgadmin/servers.json can't store secrets.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# Required by dags/utils.py's fetch_imf_api()/fetch_ipi() (IMF's SDMX 3.0 API, api.imf.org) —
# without it, any DAG task calling those (e.g. ipi_data) fails. Get a free key by registering
# at https://portal.api.imf.org/. Not needed for DAGs that only use DBnomics (fetch_series).
IMF_API_KEY=

# The dbt project lives in dbt/ and runs as the dbt-api service in this compose stack
# (POST /run). Airflow reaches it at http://dbt-api:8000 over the compose network.
# DBT_API_KEY is sent as the X-API-Key header by dags/dbt_jobs_analytics.py and checked by
# dbt-api; both read it from this file. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DBT_API_KEY=
# Host port for manual calls to dbt-api (published on 127.0.0.1 only), e.g.
#   curl -X POST http://localhost:8001/run -H "X-API-Key: <key>"
DBT_API_PORT=8001
