	measure _current_gdp_per_capita = ```
			
			VAR current_year_gdp = MAX(f_gross_domestic_product[period])
			VAR current_year_pop = MAX(imf_population[period])
			VAR current_year = IF(current_year_gdp <= current_year_pop, current_year_gdp, current_year_pop)
			VAR gdp = SUMX(
			        FILTER(f_gross_domestic_product, f_gross_domestic_product[period] = current_year), 
			        f_gross_domestic_product[value_usd]
			        )
			VAR pop = SUMX(FILTER(imf_population, imf_population[period]=current_year),
			        imf_population[value]
			)
			RETURN DIVIDE(gdp, pop, 0)*1000000
			```
		lineageTag: bd843749-183e-4314-b292-960a06e8403a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

