	measure _current_gdp = ```
			
			VAR current_year = [_current_gpd_year]
			RETURN    SUMX(
			        FILTER(f_gross_domestic_product, YEAR(f_gross_domestic_product[period]) = current_year), 
			        f_gross_domestic_product[value_usd]
			        )
			
			```
		formatString: #,0
		lineageTag: 771115f7-48f8-4ad6-8232-f48a91ff8e83

	measure _yoy_gdp = ```
			
			VAR current_year = YEAR(MAX(f_gross_domestic_product[period]))
			VAR current_gdp = SUMX(FILTER(f_gross_domestic_product, YEAR(f_gross_domestic_product[period]) = current_year), f_gross_domestic_product[value_usd])
			VAR previous_gdp = CALCULATE(
			        SUM(f_gross_domestic_product[value_usd]),
			        // SAMEPERIODLASTYEAR(f_gross_domestic_product[period]),
			        SAMEPERIODLASTYEAR(d_calendar[Date]),
			        REMOVEFILTERS(f_gross_domestic_product) 
			    )
			
			RETURN DIVIDE(current_gdp-previous_gdp, previous_gdp, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 6910365f-2c5f-4338-8e79-ffe5f05290ba

	measure _current_year = YEAR(NOW())-2
		formatString: 0
		lineageTag: 84d99c77-3cbb-4786-9316-596564a90962
		dataCategory: Uncategorized

	measure _total_gdp = SUMX(f_gross_domestic_product, f_gross_domestic_product[value])
		lineageTag: f04dbf27-bae1-40d4-8633-3af4b01be867

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _yoy_ipi =
			
			VAR latest_date = MAX(f_industrial_production_index[Date])
			VAR latest_year = YEAR(latest_date)
			VAR same_date_previous_year = MAX(f_industrial_production_index[Date])-365
			VAR previous_year = YEAR(same_date_previous_year)
			VAR current_ipi = AVERAGEX(FILTER(f_industrial_production_index, AND(YEAR(f_industrial_production_index[Date])=latest_year, f_industrial_production_index[Date]<=latest_date)), f_industrial_production_index[value])
			VAR previous_ipi = AVERAGEX(FILTER(f_industrial_production_index, AND(YEAR(f_industrial_production_index[Date])=previous_year, f_industrial_production_index[Date]<=same_date_previous_year)), f_industrial_production_index[value])
			RETURN DIVIDE(current_ipi-previous_ipi, previous_ipi, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 98ca56b1-bba7-44f3-9289-b677f32a2d71

	measure _previous_year = [_current_year]-1
		formatString: 0
		lineageTag: 4e8d848d-a201-4ec9-a69b-d52d7eaba04b

	measure _mom_ipi =
			
			VAR latest_date = MAX(f_industrial_production_index[Date])
			VAR previous_month = EOMONTH(latest_date, -2) + 1
			VAR current_ipi = SUMX(FILTER(f_industrial_production_index, f_industrial_production_index[Date]=latest_date), f_industrial_production_index[value])
			VAR previous_ipi = SUMX(FILTER(f_industrial_production_index, f_industrial_production_index[Date]=previous_month), f_industrial_production_index[value])
			RETURN DIVIDE(current_ipi-previous_ipi, previous_ipi, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 8791e000-4a27-4234-943b-ba964f856d4f

	measure _current_month = [_current_year]*100+MONTH(MAXX(FILTER(f_industrial_production_index, YEAR(f_industrial_production_index[Date])=[_current_year]), f_industrial_production_index[Date]))
		formatString: 0
		lineageTag: f81da267-89bb-495f-b5af-35ddbef6f043

	measure _previous_month = [_current_month]-1
		formatString: 0
		lineageTag: f9da6273-8208-45ce-bbf0-58960575012b

	measure _yoy_cpi_overview = ```
			
			VAR latest_date = MAX(f_consumer_price_index[period])
			VAR latest_year = YEAR(latest_date)
			VAR same_date_previous_year = MAX(f_consumer_price_index[period])-365
			VAR previous_year = YEAR(same_date_previous_year)
			
			VAR current_cpi = SUMX(FILTER(f_consumer_price_index, AND(YEAR(f_consumer_price_index[period])=latest_year, f_consumer_price_index[period]<= latest_date)), f_consumer_price_index[value])
			// VAR previous_cpi = CALCULATE(
			//         SUM(f_consumer_price_index[value]),
			//         SAMEPERIODLASTYEAR(f_consumer_price_index[period]),
			//         REMOVEFILTERS(f_consumer_price_index) 
			//     )
			VAR previous_cpi = CALCULATE(
			        SUM(f_consumer_price_index[value]),
			        YEAR(f_consumer_price_index[period])=previous_year,
			        f_consumer_price_index[period]<= same_date_previous_year
			    )
			RETURN DIVIDE(current_cpi-previous_cpi, previous_cpi, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 459786dc-d6e6-4654-baae-550fd2f6210e

	measure _mom_cpi =
			
			VAR latest_date = MAX(f_consumer_price_index[period])
			VAR previous_month = EOMONTH(latest_date, -2) + 1
			VAR current_cpi = SUMX(FILTER(f_consumer_price_index, f_consumer_price_index[period]=latest_date), f_consumer_price_index[value])
			VAR previous_cpi = SUMX(FILTER(f_consumer_price_index, f_consumer_price_index[period]=previous_month), f_consumer_price_index[value])
			
			RETURN DIVIDE(current_cpi-previous_cpi, previous_cpi, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 356619cc-f2ec-4406-a71b-8a69835aae58

	measure _current_policy_rate_overview = ```
			
			VAR latest_date = MAX(f_cb_policy_rates[period])
			VAR policy_rate = AVERAGEX(FILTER(f_cb_policy_rates, f_cb_policy_rates[period]=latest_date), f_cb_policy_rates[value]/100)
			
