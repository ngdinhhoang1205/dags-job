	measure _mom_retail =
			
			VAR current_year = YEAR(MAX(f_retail_sales[period]))
			VAR previous_year = current_year-1
			VAR current_month = current_year*100 + MAXX(FILTER(f_retail_sales, YEAR(f_retail_sales[period])=current_year), MONTH(f_retail_sales[period]))
			VAR previous_month = IF(MAXX(FILTER(f_retail_sales, YEAR(f_retail_sales[period])=current_year), MONTH(f_retail_sales[period]))=1, previous_year*100+12, current_month-1)
			VAR current_retail = SUMX(FILTER(f_retail_sales, YEAR(f_retail_sales[period])*100+MONTH(f_retail_sales[period])=current_month), f_retail_sales[value])
			VAR previous_retail = SUMX(FILTER(f_retail_sales, YEAR(f_retail_sales[period])*100+MONTH(f_retail_sales[period])=previous_month), f_retail_sales[value])
			
			RETURN DIVIDE(current_retail-previous_retail, previous_retail, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c618621a-d96c-4849-b755-b51a451ada6c

	measure _current_import_goods =
			
			VAR current_year_goods = YEAR(MAX(f_imf_imports_goods[period]))
			VAR current_year_service = YEAR(MAX(f_imf_imports_services[period]))
			VAR current_year = IF(current_year_goods<current_year_service, current_year_goods, current_year_service)
			VAR current_value_goods = SUMX(FILTER(f_imf_imports_goods, YEAR(f_imf_imports_goods[period])=current_year), f_imf_imports_goods[value])
			VAR current_value_services = SUMX(FILTER(f_imf_imports_services, YEAR(f_imf_imports_services[period])=current_year), f_imf_imports_services[value])
			RETURN DIVIDE(current_value_goods, 1000000)
		lineageTag: ac0e8b5b-6108-4177-9bd1-cc3039f294c1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _current_export_goods =
			
			VAR current_year_goods = YEAR(MAX(f_imf_exports_goods[period]))
			VAR current_year_service = YEAR(MAX(f_imf_exports_services[period]))
			VAR current_year = IF(current_year_goods<current_year_service, current_year_goods, current_year_service)
			
			VAR current_value_goods = SUMX(FILTER(f_imf_exports_goods, YEAR(f_imf_exports_goods[period])=current_year), f_imf_exports_goods[value])
			VAR current_value_services = SUMX(FILTER(f_imf_exports_services, YEAR(f_imf_exports_services[period])=current_year), f_imf_exports_services[value])
			RETURN DIVIDE(current_value_goods, 1000000)
		lineageTag: 7916cc5f-783f-4170-bb1f-993ca0853246

		annotation PBI_FormatHint = {"isGeneralNumber":true}

