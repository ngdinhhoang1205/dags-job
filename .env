# UID used inside the Airflow containers (irrelevant on native Windows, matters if you're
# running Docker via WSL2 with a Linux user mapping). 50000 is the image's built-in "airflow" user.
AIRFLOW_UID=50000

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# Change this before running anywhere but local dev.
AIRFLOW_WEBSERVER_SECRET_KEY=please-change-me

# Airflow UI admin login created by airflow-init.
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Second, separate Postgres instance for business/application data (not Airflow metadata).
# Exposed on the host at BUSINESS_POSTGRES_PORT so external tools can connect directly.
BUSINESS_POSTGRES_USER=business
BUSINESS_POSTGRES_PASSWORD=business
BUSINESS_POSTGRES_DB=business
BUSINESS_POSTGRES_PORT=5433

# pgAdmin — UI for both Postgres instances (both are pre-registered under Servers).
# Login below is for pgAdmin itself; DB passwords are entered on first connect per server
# (airflow/airflow and business/business by default) since pgadmin/servers.json can't store secrets.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
